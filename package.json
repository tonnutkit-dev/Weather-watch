{
  "name": "weather-watch",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:data": "python3 scripts/verify_providers.py",
    "preview": "vite preview",
    "verify:pages": "node scripts/verify_pages_build.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.3"
  }
}
